{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@factory/engine": ["packages/engine/src/index.ts"],
      "@factory/platform": ["packages/platform/src/index.ts"],
      "@factory/games/*": ["games/*/src/index.ts"]
    }
  },
  "include": [
    "packages/**/*.ts",
    "games/**/*.ts",
    "apps/**/*.ts",
    "scripts/**/*.mjs"
  ]
}
